# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# GEMINI_API_KEY: Required for Gemini AI API calls on the backend (the general engine and the Strategy Builder share it).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# NODE_ENV: must be "production" on Render so the built site is served.
NODE_ENV="production"

# APP_URL: Public URL of the site (used in email links), e.g. https://marketx.world
APP_URL="https://marketx.world"

# Optional security settings
# ALLOWED_ORIGINS: extra sites (comma-separated) allowed to call the API from a browser.
#   The APP_URL site (apex + www) is always allowed. Example: https://marketx-xyz.onrender.com
ALLOWED_ORIGINS=""
# CLIENT_IP_HEADER: header your proxy/CDN sets with the real visitor IP (used for rate limits).
#   Leave empty on Render; set to "cf-connecting-ip" style values only if you add another proxy in front.
CLIENT_IP_HEADER=""

# ---------------------------------------------------------------------------
# Database: Firebase Firestore (storage only — NOT used for authentication)
# ---------------------------------------------------------------------------
# Firebase Console → Project settings → Service accounts → Generate new private key.
# Paste the whole JSON file contents (or its base64) as one value.
FIREBASE_SERVICE_ACCOUNT=""

# ---------------------------------------------------------------------------
# Authentication (handled by this server)
# ---------------------------------------------------------------------------
# Random secret (32+ chars) used to sign session cookies, e.g. `openssl rand -hex 32`
SESSION_SECRET=""
# Google sign-in: Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web)
GOOGLE_CLIENT_ID=""

# Admin console (/admin): REQUIRED to sign in the first time. Use a long, private password (12+ characters).
# There is no built-in default: without this (and without a custom password saved from the console), admin sign-in
# is disabled. A custom password set inside the console takes precedence; "Reset to default" returns to this value.
ADMIN_DEFAULT_PASSWORD=""

# Invite-only access: each batch holds 50 one-time pass codes generated by the server.
# Raise this number (e.g. "2") to open the next batch once the current one is fully allocated.
ACCESS_CODE_BATCH="1"
# Sign-up abuse guard: one device, one email, one IP. Accounts allowed per IP address within the window
# (0 turns the IP rule off; device and alias rules always apply). IPs are reassigned over time, hence the window.
SIGNUP_ACCOUNTS_PER_IP="1"
SIGNUP_IP_WINDOW_DAYS="30"
# Capacity (optional). AI engine calls running at once, and how long a request may wait for a slot (ms) before the
# computed real-candle analysis is served instead. Per-account request limits per minute (a per-IP ceiling is 20x).
AI_MAX_CONCURRENCY="24"
AI_QUEUE_WAIT_MS="9000"
RATE_LIMIT_ANALYSIS_PER_MIN="45"
RATE_LIMIT_API_PER_MIN="180"
# Fundamental Analysis (optional): total time one fundamental read may take (ms), under the app's 110s limit.
FUNDAMENTAL_BUDGET_MS="85000"
# Daily news alerts (optional): hour of the day (0-23, in CREDIT_RESET_TZ) from which the morning alert goes out. Default 7.
NEWS_ALERT_HOUR="7"
# Daily analyses refill every day at 3:00 AM in this time zone (IANA name). Default Africa/Lagos.
CREDIT_RESET_TZ="Africa/Lagos"
# Real-time market data. Live prices refresh every LIVE_TICK_MS while anyone is watching and are pushed to browsers
# as they change. FX, stocks and indices (Yahoo) refresh every LIVE_YAHOO_MS; faster gets the server blocked.
# Quotes and candles for an analysis are fetched live; only requests in the same LIVE_QUOTE_FRESH_MS share a fetch.
LIVE_TICK_MS="1000"
LIVE_YAHOO_MS="3000"
LIVE_QUOTE_FRESH_MS="1000"
# Live stream connections (per worker, and per IP; mobile carriers put many people behind one IP)
LIVE_STREAM_MAX_CLIENTS="20000"
LIVE_STREAM_PER_IP="300"
# Outgoing email pace across the whole server (Gmail tolerates ~20/min sustained). Security mail always goes first;
# activity mail is deduplicated per person and dropped under a big backlog.
SMTP_MAX_PER_MINUTE="20"
# Multi-core: number of worker processes (set to the instance's CPU count, e.g. 2 or 4). Limits above are shared
# across workers, so they stay exactly as strict. Default 1.
WEB_CONCURRENCY="1"

# Optional: extra comma-separated emails with unlimited access (must be verified emails)
UNLIMITED_EMAILS=""

# ---------------------------------------------------------------------------
# Paystack payments
# ---------------------------------------------------------------------------
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_SECRET_KEY=""
# Pro is priced in USD and charged in PAYSTACK_CHARGE_CURRENCY at the live exchange rate.
# Nigerian Paystack accounts charge in NGN (this also enables bank transfer and USSD).
# Only set USD here if Paystack has approved USD payments on your account.
PAYSTACK_CHARGE_CURRENCY="NGN"
PRO_QUARTER_PRICE_USD="30"
PRO_YEARLY_BASE_USD="200"
PRO_YEARLY_OFF_PERCENT="12"
# Optional fallback rate, used only until the live rate loads (e.g. 1550)
USD_NGN_RATE=""
# The Trading Agent has its own plan: $30 a month, a year at 12 months less 18% ($295.20) (set in server/payments.ts)

# ---------------------------------------------------------------------------
# Trading agent: MT5 execution through MetaApi (https://metaapi.cloud). Without a token the agent tracks trades
# and alerts the exact order instead. Server only: never put it in the browser or in a VITE_ variable.
# ---------------------------------------------------------------------------
METAAPI_TOKEN=""
# Region of the MetaApi servers for new linked accounts (new-york, london, singapore…)
METAAPI_REGION="new-york"

# ---------------------------------------------------------------------------
# Gmail SMTP (email verification, password reset, gifts, rewards, payments)
# ---------------------------------------------------------------------------
SMTP_USER=""   # the Gmail address
SMTP_PASS=""   # a Google App Password (requires 2-Step Verification)
SMTP_FROM=""   # optional, e.g. "MarketX <you@gmail.com>"
# Optional: emails per trader per day from price alerts + the watchlist together (default 5; site notifications are never capped)
MARKET_MAIL_PER_DAY=""
# Optional: web push keys (base64url raw P-256). Leave empty: a pair is generated once and kept in Firestore.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""   # optional, e.g. "mailto:you@gmail.com"

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Deriv API app id for live synthetic indices (defaults to Deriv's public id 1089)
DERIV_APP_ID=""
# Telegram channel invite link behind the site's Telegram buttons (/go/telegram redirects here)
TELEGRAM_INVITE_URL=""   # your t.me invite link (kept only here on the server, never in the code)
YOUTUBE_CHANNEL_URL=""   # optional: youtube.com channel for /go/youtube (default: the MarketX channel)
X_PROFILE_URL=""         # optional: x.com profile for /go/x (default: https://x.com/_MarketX)
# VITE_API_URL: only when hosting the frontend separately from the backend
VITE_API_URL=""

# ---------------------------------------------------------------------------
# Solana: token safety check and on-chain signal proofs (both free to run)
# ---------------------------------------------------------------------------
# SOLANA_RPC_URL: optional. Defaults to the free public mainnet RPC. A provider URL (e.g. Helius free tier) is
#   more reliable; it may contain a key, so it is never logged or sent to the browser.
SOLANA_RPC_URL=""
# SOLANA_PROOF_SECRET_KEY: optional. A NEW wallet used only to write proof batches (never your main wallet).
#   Solana CLI JSON array (64 numbers) or the base58 secret Phantom exports. Its address is public on every proof
#   transaction, so fund it from an exchange withdrawal, not from your main wallet (a direct transfer links the two
#   on chain). Each batch and each result record costs 0.000005 SOL; 0.05 SOL covers about 10,000 of them. Without it, signals are still sealed and batched, and are
#   anchored on Solana as soon as a key is added.
SOLANA_PROOF_SECRET_KEY=""
# PROOF_BATCH_MS: how often new sealed signals are batched and anchored (default 60000 = 1 minute, only when new
#   signals exist; each batch costs 0.000005 SOL)
# PROOF_BATCH_MS="60000"
# REVEAL_AFTER_MS: a trade still running this long after it was served gets its readable result record anyway
#   (default 86400000 = 24 hours; a trade that ends earlier is written when it ends). One memo per trade, 0.000005 SOL.
# REVEAL_AFTER_MS="86400000"
# TRADER_ID_SECRET: optional. Derives every trader's MarketX ID (their Solana address listing their trade records).
#   Without it a secret is generated once and kept in Firestore. Set it once and never change it: every ID would change.
# TRADER_ID_SECRET=""
# REVEAL_TRACK_MS: how often sealed trades are followed on 1-minute candles for their result (default 300000 = 5 min)
# REVEAL_TRACK_MS="300000"
# PROOF_RETRY_MS: how often a batch waiting for its Solana transaction is retried (default 600000 = 10 minutes)

# MIN_SIGNAL_QUALITY: lowest setup quality (0-95) the analysis serves as a trade (default 45; below it similar setups broke
#   even at best in the back-tests). Leave unset in production.
# MIN_SIGNAL_QUALITY="45"
# VOLUME_POC_MIN_R: volume confluence on charts up to 2H (markets with real volume): a buy's entry must sit this many R below the
#   point of control, a sell above it (default 1; "off" for tests only). Leave unset in production.
# VOLUME_POC_MIN_R="1"
