# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# GEMINI_API_KEY: Required for Gemini AI API calls on the backend.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# NODE_ENV: must be "production" on Render so the built site is served.
NODE_ENV="production"

# APP_URL: Public URL of the site (used in email links), e.g. https://marketx.world
APP_URL="https://marketx.world"

# ---------------------------------------------------------------------------
# Firebase (accounts, credits, history, payments) — REQUIRED for sign-in
# ---------------------------------------------------------------------------
# Firebase Console → Project settings → Service accounts → Generate new private key.
# Paste the whole JSON file contents (or its base64) as one value.
FIREBASE_SERVICE_ACCOUNT=""
# Firebase Console → Project settings → General → Your apps (Web app config)
FIREBASE_WEB_API_KEY=""
FIREBASE_PROJECT_ID=""
FIREBASE_AUTH_DOMAIN=""   # optional, defaults to <project-id>.firebaseapp.com
FIREBASE_APP_ID=""        # optional

# Optional: extra comma-separated emails with unlimited access (must be verified emails)
UNLIMITED_EMAILS=""

# ---------------------------------------------------------------------------
# Paystack payments
# ---------------------------------------------------------------------------
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_SECRET_KEY=""
# Currency your Paystack account settles in, and prices in the minor unit (cents / kobo)
PAYSTACK_CURRENCY="USD"
PAYSTACK_MONTHLY_AMOUNT="1800"
PAYSTACK_YEARLY_AMOUNT="18792"

# ---------------------------------------------------------------------------
# Gmail SMTP (transactional emails: gifts, rewards, payments)
# ---------------------------------------------------------------------------
SMTP_USER=""   # the Gmail address
SMTP_PASS=""   # a Google App Password (requires 2-Step Verification)
SMTP_FROM=""   # optional, e.g. "MarketX <you@gmail.com>"

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Deriv API app id for live synthetic indices (defaults to Deriv's public id 1089)
DERIV_APP_ID=""
# VITE_API_URL: only when hosting the frontend separately from the backend
VITE_API_URL=""
