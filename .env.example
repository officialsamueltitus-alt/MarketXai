# GEMINI_API_KEY: Required for Gemini AI API calls on the backend.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_API_URL: (Optional) If deploying frontend as a standalone static site on Render/Vercel/Netlify,
# set this to your backend Render Web Service URL (e.g. https://marketx-backend.onrender.com).
# If frontend and backend are hosted together in one web service, leave empty.
VITE_API_URL=""

# PORT: Port on which the backend listens (defaults to 3000)
PORT="3000"
